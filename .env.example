# ================================================================================
# Crypto Sentiment Dashboard - Environment Variables Template
# ================================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your API keys and configuration
# 3. NEVER commit the .env file to version control
#
# ================================================================================

# ================================================================================
# APPLICATION SETTINGS
# ================================================================================
# Flask secret key - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_generate_a_random_one

# Debug mode (set to False in production)
DEBUG=True

# Application host and port
HOST=127.0.0.1
PORT=5000

# ================================================================================
# DATABASE
# ================================================================================
# SQLite (default for development)
DATABASE_URL=sqlite:///crypto_sentiment.db

# PostgreSQL (for production - uncomment and configure)
# DATABASE_URL=postgresql://username:password@localhost:5432/crypto_sentiment

# ================================================================================
# PRIMARY APIs (Free, No API Key Required)
# ================================================================================

# CoinGecko API (Main data source - no key required for basic features)
# Documentation: https://www.coingecko.com/en/api/documentation
# Rate limit: 10-50 calls/minute (free tier)
COINGECKO_API_URL=https://api.coingecko.com/api/v3
COINGECKO_RATE_LIMIT=30

# Fear & Greed Index (No key required)
# Documentation: https://alternative.me/crypto/fear-and-greed-index/
FEAR_GREED_API_URL=https://api.alternative.me/fng/

# ================================================================================
# SECONDARY APIs (Free with Registration)
# ================================================================================

# Whale Alert API
# Get your free API key at: https://whale-alert.io/
# Documentation: https://docs.whale-alert.io/
# Free tier: 10 calls/minute, 1000/month
WHALE_ALERT_API_KEY=your_whale_alert_api_key_here
WHALE_ALERT_API_URL=https://api.whale-alert.io/v1

# CoinMarketCap API (Backup data source)
# Get your free API key at: https://coinmarketcap.com/api/
# Documentation: https://coinmarketcap.com/api/documentation/v1/
# Free tier: 333 credits/day, 10k/month
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
COINMARKETCAP_API_URL=https://pro-api.coinmarketcap.com/v1

# ================================================================================
# SOCIAL MEDIA APIs
# ================================================================================

# Reddit API (via PRAW)
# Create an app at: https://www.reddit.com/prefs/apps
# Documentation: https://www.reddit.com/dev/api/
# Rate limit: 60 requests/minute
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=crypto-sentiment-dashboard:v1.0 (by /u/your_username)

# NewsAPI
# Get your free API key at: https://newsapi.org/
# Documentation: https://newsapi.org/docs
# Free tier: 100 requests/day
NEWS_API_KEY=your_newsapi_key_here
NEWS_API_URL=https://newsapi.org/v2

# ================================================================================
# OPTIONAL APIs (Advanced Features)
# ================================================================================

# Alpha Vantage (Technical Indicators)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
# Documentation: https://www.alphavantage.co/documentation/
# Free tier: 5 calls/minute, 500/day
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
ALPHA_VANTAGE_API_URL=https://www.alphavantage.co/query

# LunarCrush API (Social Metrics)
# Get your API key at: https://lunarcrush.com/developers
# Documentation: https://lunarcrush.com/developers/docs
LUNARCRUSH_API_KEY=your_lunarcrush_key_here

# CryptoCompare API
# Documentation: https://min-api.cryptocompare.com/documentation
CRYPTOCOMPARE_API_KEY=your_cryptocompare_key_here

# Messari API
# Documentation: https://messari.io/api/docs
MESSARI_API_KEY=your_messari_key_here

# ================================================================================
# EMAIL NOTIFICATIONS (SendGrid)
# ================================================================================
# Get your free API key at: https://sendgrid.com/
# Free tier: 100 emails/day
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Crypto Sentiment Dashboard

# Alternative: Gmail SMTP (uncomment to use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here
# Note: For Gmail, use an App Password, not your regular password
# Create one at: https://myaccount.google.com/apppasswords

# ================================================================================
# TELEGRAM NOTIFICATIONS
# ================================================================================
# Create a bot with @BotFather on Telegram
# Documentation: https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Your chat ID for testing (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# ================================================================================
# CACHING
# ================================================================================
# Cache type: simple (in-memory) or redis
CACHE_TYPE=simple

# Redis (for production - uncomment and configure)
# REDIS_URL=redis://localhost:6379/0

# Cache timeouts (in seconds)
CACHE_PRICE_TIMEOUT=300
CACHE_FEAR_GREED_TIMEOUT=14400
CACHE_WHALE_TIMEOUT=900
CACHE_REDDIT_TIMEOUT=1800
CACHE_NEWS_TIMEOUT=3600

# ================================================================================
# SCHEDULER
# ================================================================================
# Daily report time (24-hour format, UTC)
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0

# Enable/disable scheduled tasks
SCHEDULER_ENABLED=True

# ================================================================================
# LOGGING
# ================================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ================================================================================
# RATE LIMITING
# ================================================================================
# Enable rate limiting for the API
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=100/hour

# ================================================================================
# SECURITY
# ================================================================================
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Session settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
